{
  "name": "excel-rs",
  "version": "0.3.0",
  "description": "Fast spreadsheet import/export for Node.js: read xlsx, xls, xlsb, ods and csv with schema validation, write xlsx. Rust core compiled to WebAssembly, zero runtime dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10eputzen/excel-rs.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/10eputzen/excel-rs#readme",
  "bugs": {
    "url": "https://github.com/10eputzen/excel-rs/issues"
  },
  "keywords": [
    "excel",
    "xlsx",
    "xls",
    "xlsb",
    "ods",
    "csv",
    "spreadsheet",
    "import",
    "export",
    "wasm",
    "rust",
    "xlsx-reader",
    "xlsx-writer",
    "nodejs"
  ],
  "main": "dist/node/index.js",
  "types": "dist/node/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./detect": {
      "import": {
        "types": "./dist/browser/detect.d.ts",
        "default": "./dist/browser/detect.js"
      },
      "require": {
        "types": "./dist/node/detect.d.ts",
        "default": "./dist/node/detect.js"
      }
    },
    "./browser": {
      "types": "./dist/browser/browser.d.ts",
      "default": "./dist/browser/browser.js"
    },
    "./wasm": "./wasm/web/excel_rs_wasm_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "wasm/node/excel_rs_wasm.js",
    "wasm/node/excel_rs_wasm.d.ts",
    "wasm/node/excel_rs_wasm_bg.wasm",
    "wasm/web/excel_rs_wasm.js",
    "wasm/web/excel_rs_wasm.d.ts",
    "wasm/web/excel_rs_wasm_bg.wasm",
    "wasm/web/package.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:ts": "node scripts/build-ts.mjs",
    "build": "npm run build:wasm && npm run build:ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test test/read.test.mjs test/write.test.mjs test/robustness.test.mjs test/performance.test.mjs test/browser-entry.test.mjs test/schema.test.mjs test/detect.test.mjs test/properties.test.mjs test/golden.test.mjs",
    "prepack": "node -e \"require('fs').copyFileSync('../README.md','README.md')\"",
    "fixtures": "node scripts/make-fixtures.mjs",
    "test:browser": "node --test test/browser.e2e.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^4.11.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
